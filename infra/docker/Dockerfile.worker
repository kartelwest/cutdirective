FROM python:3.10-slim

COPY --from=ghcr.io/astral-sh/uv:0.7.9 /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY services/api/pyproject.toml services/api/uv.lock ./

RUN uv sync --frozen --no-dev

COPY services/api/app/. ./app

ENV PYTHONPATH=/app
ENV DATABASE_URL=sqlite:////app/data/cutdirective.db
ENV CUTDIRECTIVE_ROOT=/app/CutDirective
ENV FFMPEG_PATH=ffmpeg
ENV FFPROBE_PATH=ffprobe
ENV WORKER_ID=worker-001
ENV WORKER_POLL_INTERVAL=5

CMD ["uv", "run", "python", "-m", "app.worker"]
