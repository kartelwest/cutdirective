# CutDirective AI environment example
# Copy to .env and adjust paths/secrets

# Local workspace root
CUTDIRECTIVE_ROOT=/home/ubuntu/CutDirective

# API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:////home/ubuntu/repos/cutdirective-ai/data/cutdirective.db

# Worker
WORKER_HEARTBEAT_INTERVAL_SECONDS=10

# AI provider (example: OpenAI compatible)
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
AI_API_KEY=your_key_here

# Transcription provider (example: whisper local or cloud)
TRANSCRIPTION_PROVIDER=local

# Delivery
DELIVERY_ROOT=/home/ubuntu/CutDirective/Deliveries

# Notification
NOTIFICATION_CHANNELS=in_app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CutDirective AI <cutdirective@example.com>
NOTIFICATION_RECIPIENTS=

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Logging
LOG_LEVEL=INFO
